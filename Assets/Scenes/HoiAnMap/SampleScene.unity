--- !u!114 &998155504
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 998155502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "M\xE0 d\xF9 Ivin c\xF3 \u0111\xFAng l\xE0 c\xE1i c\xE1i ki\u1EC3u \u0111\xF3
    t\xF4i c\u0169ng kh\xF4ng v\xEC th\u1EBF m\xE0 gh\xEA t\u1EDFm nh\u01B0 nh\u1EEFng
    ng\u01B0\u1EDDi kh\xE1c. Ph\u1EA7n l\xE0 v\xEC t\xF4i kh\xF4ng quan t\xE2m, ph\u1EA7n
    v\xEC kh\xF4ng mu\u1ED1n m\u1EA5t \u0111i m\u1ED9t Ch\xFA binh trong \u0111i\u1EC1u
    ki\u1EC7n khan hi\u1EBFm th\u1EBF n\xE0y.\r\nD\xF9 ch\xFA binh \u0111ang khan
    hi\u1EBFm nh\u01B0ng th\u1EF1c t\u1EBF kh\xF4ng n\xEAn \u0111\xE1nh gi\xE1 qu\xE1
    cao ph\xE9p thu\u1EADt \u2013 hay g\u1ECDi l\xE0 h\u1EC7 h\xE0m Alicia trong
    th\u1EDDi \u0111\u1EA1i n\xE0y. T\xF4i \u0111\xE3 th\u1EA5y m\u1ED9t \u1ED5 s\xFAng
    m\xE1y \u0111\u1EB7t \u0111\xFAng ch\u1ED7 gi\u1EBFt \u0111\u01B0\u1EE3c nhi\u1EC1u
    ng\u01B0\u1EDDi h\u01A1n c\u1EA3 m\u1ED9t ti\u1EC3u \u0111\u1ED9i ph\xE1p s\u01B0.
    Nh\u01B0ng b\u1EA3o Ch\xFA binh v\xF4 d\u1EE5ng th\xEC l\u1EA1i l\xE0 sai. N\xF3
    gi\u1ED1ng m\u1EA5y th\u1EB1ng ng\u1ED1c cho r\u1EB1ng c\xF3 s\xFAng r\u1ED3i
    th\xEC v\xF5 s\u0129 h\u1EBFt \u0111\u1EA5t d\u1EE5ng v\xF5, m\xE0 qu\xEAn m\u1EA5t
    v\xF5 s\u0129 c\u0169ng c\u1EA7m \u0111\u01B0\u1EE3c s\xFAng. Ng\u01B0\u1EDDi
    c\xF3 s\u1EB5n c\xE1i v\u1ED1n h\u01A1n ng\u01B0\u1EDDi m\xE0 v\u1EABn \u0111\u01B0\u1EE3c
    trang b\u1ECB y nh\u01B0 ng\u01B0\u1EDDi th\u01B0\u1EDDng th\xEC \u0111\xE3 \u0111i
    tr\u01B0\u1EDBc m\u1ED9t b\u01B0\u1EDBc r\u1ED3i.\r\nL\xE0m ng\u01B0\u1EDDi \u0111\u1EE9ng
    gi\u1EEFa, t\u1EEB quan tr\xEAn xu\u1ED1ng l\xEDnh d\u01B0\u1EDBi, t\xF4i c\xF3
    th\xF3i quen \u0111\u1EC3 \xFD \u0111\xE1m thanh ni\xEAn n\xE0y k\u1EF9 h\u01A1n
    khi c\xF3 c\u01A1 h\u1ED9i. V\xEC th\u1EBF ch\u1EC9 c\xF3 t\xF4i th\u1EA5y l\u1EDDi
    c\u1EA3m \u01A1n l\xFAc n\xE3y c\u1EE7a Ivin d\xE0i h\u01A1n n\u1EEDa nh\u1ECBp
    c\u1EA7n thi\u1EBFt. C\u0169ng ch\u1EC9 c\xF3 t\xF4i \u0111\u1EC3 \xFD Daniel
    kh\xF4ng \u0111\xE1p l\u1EA1i. C\u1EADu ta ch\u1EC9 g\u1EADt \u0111\u1EA7u r\u1EA5t
    kh\u1EBD, r\u1ED3i quay \u0111i ki\u1EC3m tra y\xEAn ng\u1EF1a c\u1EE7a Ivin
    tr\u01B0\u1EDBc khi ki\u1EC3m tra y\xEAn ng\u1EF1a c\u1EE7a m\xECnh. M\u1ED9t
    c\xE1i nh\xECn l\u01B0\u1EDBt qua, nhanh nh\u01B0 ch\u01B0a t\u1EEBng x\u1EA3y
    ra, th\u1EBF m\xE0 t\xF4i \u0111\xE3 g\u1EB7p n\xF3 \u0111\u1EE7 nhi\u1EC1u l\u1EA7n
    \u0111\u1EC3 bi\u1EBFt n\xF3 l\xE0 g\xEC.\r\nT\xF4i ch\u01B0a g\u1ECDi t\xEAn
    \u0111\u01B0\u1EE3c th\u1EE9 \u0111\xF3, v\xE0 c\u0169ng kh\xF4ng \u0111\u1ECBnh
    g\u1ECDi. H\u1ED3i s\xE1ng t\xF4i t\xE1ch hai \u0111\u1EE9a ra, t\xF4i t\u1EF1
    nh\u1EE7 l\xE0 v\xEC k\u1EF7 lu\u1EADt. Th\u1EADt ra t\xF4i ch\u1EC9 mu\u1ED1n
    gi\u1EA3m s\u1ED1 l\u1EA7n ng\u01B0\u1EDDi kh\xE1c c\xF3 c\u01A1 h\u1ED9i nh\xECn
    th\u1EA5y c\xE1i nh\xECn kia. T\xF4i bi\u1EBFt c\xE1i gi\xE1 ph\u1EA3i tr\u1EA3
    n\u1EBFu c\xF3 ai kh\xE1c nh\xECn ra, nh\u1EA5t l\xE0 khi m\u1ED9t \u0111\u1EE9a
    l\xE0 t\xE2n binh, \u0111\u1EE9a kia m\u1EDBi ch\xE2n \u01B0\u1EDBt ch\xE2n r\xE1o
    v\xE0o trung \u0111\u1ED9i \u0111\u01B0\u1EE3c v\xE0i th\xE1ng. Daniel ng\u1EADm
    \u0111i\u1EBFu thu\u1ED1c \u1EA5y c\u1EA3 ng\xE0y m\xE0 ch\u01B0a bao gi\u1EDD
    d\xE1m h\xEDt. C\u1EADu ta ra v\u1EBB b\u1EA5t c\u1EA7n l\xE0 \u0111\u1EC3 ng\u01B0\u1EDDi
    ta nh\xECn v\xE0o c\xE1i v\u1ECF \u0111\xF3 ch\u1EE9 \u0111\u1EEBng nh\xECn th\xEAm
